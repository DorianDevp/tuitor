# Written by the release workflow from packaging/homebrew/tuitor.rb.tmpl in
# https://github.com/DorianDevp/tuitor; changes here are overwritten by the next release.
class Tuitor < Formula
  desc "Terminal debugger for every language, built on the Debug Adapter Protocol"
  homepage "https://doriandevp.github.io/tuitor/"
  version "@VERSION@"
  license "GPL-3.0-or-later"

  on_macos do
    on_arm do
      url "https://github.com/DorianDevp/tuitor/releases/download/v@VERSION@/tuitor-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/DorianDevp/tuitor/releases/download/v@VERSION@/tuitor-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/DorianDevp/tuitor/releases/download/v@VERSION@/tuitor-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/DorianDevp/tuitor/releases/download/v@VERSION@/tuitor-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "tuitor"
    doc.install "README.md", "CHANGELOG.md"
  end

  def caveats
    <<~EOS
      tuitor runs debug adapters; it does not bundle them. `tuitor doctor` lists what is
      missing and `tuitor install <adapter>` fetches js-debug, vscode-php-debug or CodeLLDB.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tuitor --version")
  end
end
