# What every demo shares, sourced by each tape. The colours are tuitor's own (ui/theme.rs):
# tuitor paints every cell itself, so the theme shows only in the padding around it.
Set Shell "bash"
Set FontFamily "Iosevka Nerd Font Mono"
Set FontSize 16
Set Width 1600
Set Height 900
Set Padding 16
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme { "name": "tuitor", "background": "#0c0c0e", "foreground": "#d6d6d6", "cursor": "#d6d6d6", "selection": "#2b2b33", "black": "#0c0c0e", "red": "#e06666", "green": "#8fd6ab", "yellow": "#e3a34a", "blue": "#96abc6", "magenta": "#ada3ff", "cyan": "#86abb6", "white": "#d6d6d6", "brightBlack": "#737373", "brightRed": "#e06666", "brightGreen": "#8fd6ab", "brightYellow": "#e3a34a", "brightBlue": "#96abc6", "brightMagenta": "#ada3ff", "brightCyan": "#86abb6", "brightWhite": "#f5f5f5" }
